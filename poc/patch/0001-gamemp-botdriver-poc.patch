+  if (BotDriver_HandleTimer(this)) {
+    return;
+  }
+
   // if direct input is active
   if( _pInput->IsInputEnabled() && !gm_bMenuOn)
   {
@@ -1016,6 +1023,10 @@ void CGame::InitInternal( void)
 
   CAM_Init();
 
+  // [BotDriver] declare bot console symbols (must happen before persistent
