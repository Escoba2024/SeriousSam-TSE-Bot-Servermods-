+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {classifyRoster,telemetryActive,processIdentity,verifyRuntime} from '../runtime.js';
+
+test('only unique verified roster names can be associated with bots',()=>{
+ const fields={player_0:'Pip',player_1:'Guest',player_2:'BOT-Spoof'};
+ assert.deepEqual(classifyRoster(fields,['Pip']),['Pip']);
+ assert.deepEqual(classifyRoster({...fields,player_3:'Pip'},['Pip']),[]);
+ assert.deepEqual(classifyRoster(fields,['Pip','Pip']),[]);
+});
+test('telemetry needs complete recent active row and expected local count',()=>{
+ const now=Date.now();const row=(t:number,lp=4)=>`${t},20,80,20,20,0,${lp},1,1,0,0,0,0,0.003,0.001,51,50,200,10,0,0\n`;
+ assert.equal(telemetryActive(row(now),4,now),true);
+ assert.equal(telemetryActive(row(now-60000),4,now),false);
+ assert.equal(telemetryActive(row(now+60000),4,now),false);
+ assert.equal(telemetryActive(row(now,1),4,now),false);
+ assert.equal(telemetryActive(row(now).trimEnd(),4,now),false);
+});
+test('proc stat parser handles spaces and parentheses in comm',()=>{
+ const tail=['S',...Array(18).fill('0'),'1234','0'];
+ assert.equal(processIdentity('12 (x y) z) '+tail.join(' ')).startTicks,1234);
+});
+test('missing receipt never verifies guessed runtime',async()=>{
+ const r=await verifyRuntime({runtimeResultPath:'/missing/result.json'} as any);
+ assert.equal(r.verified,false);assert.deepEqual(r.botNames,[]);
+});
