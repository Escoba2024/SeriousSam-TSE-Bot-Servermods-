+import fs from 'node:fs/promises';
+import {createHash} from 'node:crypto';
+import path from 'node:path';
+import type {ServerDefinition} from './backend.js';
+
+const digest=(b:Buffer|string)=>createHash('sha256').update(b).digest('hex');
+export function processIdentity(stat:string){
+ const fields=stat.slice(stat.lastIndexOf(')')+2).trim().split(/\s+/);
+ return {state:fields[0],startTicks:Number(fields[19])};
+}
+export function telemetryActive(text:string,count:number,now=Date.now()):boolean {
+ const rows=text.split('\n');rows.pop();
+ const row=rows.filter(x=>/^\d+,/.test(x)).at(-1)?.split(',').map(Number);
+ return !!row && row.length===21 && row.every(Number.isFinite) && now-row[0]!>=0 && now-row[0]!<=15000 &&
+  row[1]!>=15 && row[1]!<=30 && row[2]!>0 && row[6]===count && row[7]===1 && row[8]===1 && row[20]===0;
+}
+export function classifyRoster(fields:Record<string,string>,names:string[]):string[]{
+ const queried=Object.entries(fields).filter(([k])=>/^player_\d+$/.test(k)).map(([,v])=>v);
+ return names.filter(n=>names.filter(x=>x===n).length===1 && queried.filter(x=>x===n).length===1);
+}
+export async function boundedTail(file:string,limit=65536){
+ const handle=await fs.open(file,'r');
+ try{const s=await handle.stat();if(!s.isFile())throw new Error('Not regular file');const start=Math.max(0,s.size-limit);
+ const b=Buffer.alloc(Math.min(s.size,limit));const {bytesRead}=await handle.read(b,0,b.length,start);
+ return {text:b.subarray(0,bytesRead).toString('utf8'),truncated:start>0,mtimeMs:s.mtimeMs};
+ }finally{await handle.close();}
+}
+type Role={pid:number;start_ticks:number;cwd:string;uid:number;cgroup:string;binaryHashes:Record<string,string>;profiles?:Array<{slot:number;name:string;profileHash:string;guidHash:string}>};
+type Receipt={version:number;resultHash:string;roles:Record<string,Role>};
+export type RuntimeEvidence={verified:boolean;telemetryFresh:boolean;botNames:string[];uptimeSeconds:number|null;alerts:string[];generation?:string};
+export async function verifyRuntime(s:ServerDefinition,procRoot='/proc'):Promise<RuntimeEvidence>{
+ const failed:RuntimeEvidence={verified:false,telemetryFresh:false,botNames:[],uptimeSeconds:null,alerts:['RUNTIME_IDENTITY_UNVERIFIED']};
+ try {
+  if(!s.runtimeIdentityPath)return failed;
+  const receipt=JSON.parse(await fs.readFile(s.runtimeIdentityPath,'utf8')) as Receipt;
+  const resultBytes=await fs.readFile(s.runtimeResultPath);if(receipt.version!==1 || digest(resultBytes)!==receipt.resultHash)return failed;
+  const result=JSON.parse(resultBytes.toString());const root=path.dirname(s.runtimeResultPath);
+  const names:string[]=[];let telemetryFresh=true;
+  const checks:Array<()=>Promise<void>>=[];
+  for(const role of ['server','botA','botB']){
+   const pin=receipt.roles[role];const recorded=result.processes?.[role];
+   if(!pin || !recorded || pin.pid!==recorded.pid || pin.start_ticks!==recorded.start_ticks || pin.cwd!==recorded.cwd || pin.cwd!==path.join(root,role))return failed;
+   const check=async()=>{
+    const p=path.join(procRoot,String(pin.pid));const identity=processIdentity(await fs.readFile(p+'/stat','utf8'));
+    if(identity.startTicks!==pin.start_ticks || ['Z','X'].includes(identity.state??'') || await fs.realpath(p+'/cwd')!==pin.cwd ||
+      (await fs.stat(p)).uid!==pin.uid || (await fs.readFile(p+'/cgroup','utf8')).trim()!==pin.cgroup)throw new Error('Process changed');
+    const cmd=await fs.readFile(p+'/cmdline','utf8');if(!cmd.includes(role==='server'?'Bin/DedicatedServer.exe':'Bin/SeriousSam.exe'))throw new Error('Wrong executable');
+   };await check();checks.push(check);
+   const files=role==='server'?['DedicatedServer.exe','Engine.dll','EntitiesMP.dll','GameMP.dll']:['SeriousSam.exe','Engine.dll','EntitiesMP.dll','GameMP.dll'];
+   for(const name of files)if(digest(await fs.readFile(path.join(pin.cwd,'Bin',name)))!==pin.binaryHashes[name])throw new Error('Binary changed');
+   if(role!=='server'){
+    if(!pin.profiles?.length || pin.profiles.length>4)throw new Error('Missing roster');
+    for(const [slot,profile] of pin.profiles.entries()){
+     if(profile.slot!==slot)throw new Error('Roster slot mismatch');
+     const file=path.join(pin.cwd,'Players',`Player${slot}.plr`);const b=await fs.readFile(file),guid=await fs.readFile(file+'.guid');
+     if(digest(b)!==profile.profileHash || guid.length!==16 || digest(guid)!==profile.guidHash || b.indexOf(guid)<0 || b.indexOf(guid)!==b.lastIndexOf(guid))throw new Error('Profile/GUID changed');
+     names.push(profile.name);
+    }
+    const t=await boundedTail(path.join(pin.cwd,'Bin/BotTelemetry.csv'));
+    telemetryFresh &&= Date.now()-t.mtimeMs>=0 && Date.now()-t.mtimeMs<=15000 && telemetryActive(t.text,pin.profiles.length);
+   }
+  }
+  // The queried UDP port must belong to the pinned Dedicated process, not another generation.
+  const server=receipt.roles.server!;const fds=await fs.readdir(path.join(procRoot,String(server.pid),'fd'));
+  const links=await Promise.all(fds.map(f=>fs.readlink(path.join(procRoot,String(server.pid),'fd',f)).catch(()=>'')));
+  const rows=(await fs.readFile(path.join(procRoot,'net/udp'),'utf8')).trim().split('\n').slice(1).map(x=>x.trim().split(/\s+/));
+  const eligible=rows.filter(x=>parseInt(x[1]!.split(':')[1]!,16)===s.queryPort && ['00000000','0100007F'].includes(x[1]!.split(':')[0]!));
+  if(eligible.length!==1 || !links.includes(`socket:[${eligible[0]![9]}]`))throw new Error('Query owner mismatch');
+  await Promise.all(checks.map(check=>check()));
+  const uptime=Number((await fs.readFile(path.join(procRoot,'uptime'),'utf8')).split(' ')[0]);
+  // Linux on this supported deployment uses USER_HZ=100 (verified by getconf CLK_TCK).
+  return {verified:true,telemetryFresh,botNames:telemetryFresh?names:[],uptimeSeconds:Math.max(0,uptime-server.start_ticks/100),alerts:telemetryFresh?[]:['TELEMETRY_STALE'],generation:receipt.resultHash};
+ }catch{return failed;}
+}
