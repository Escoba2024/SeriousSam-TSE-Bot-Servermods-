new file mode 100644
index 0000000..cbdebf3
--- /dev/null
+++ b/deploy/monitoring-readonly.conf.example
@@ -0,0 +1,10 @@
+# Additional read-only process observation gate, after the app source/registry
+# have been staged and verified. Preserve the existing loopback/readonly unit.
+# CAP_SYS_PTRACE is needed for /proc/<different-uid-pid>/{cwd,fd} observation.
+# The actual ptrace/process_vm debug syscalls and writes through /proc are denied.
+[Service]
+CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
+AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
+ReadOnlyPaths=/proc
+SystemCallFilter=~@debug process_vm_readv process_vm_writev process_madvise
+SystemCallErrorNumber=EPERM
