+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {extractPlayers,getHealth} from '../backend.js';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+
+test('unproven BOT nickname and ordinary nickname both stay unknown',()=>{
+ const p=extractPlayers({player_0:'BOT-Spoof',player_1:'RealPlayer'});
+ assert.deepEqual(p.map(x=>x.type),['unknown','unknown']);
+});
+test('stale HEALTHY file cannot report fresh query or verified processes',async()=>{
+ const dir=await fs.mkdtemp(path.join(os.tmpdir(),'ssam-health-'));
+ try {
+  const f=path.join(dir,'health.json');
+  await fs.writeFile(f,JSON.stringify({utc:'2026-01-01T00:00:00Z',status:'HEALTHY',query_fresh:true,telemetry_fresh:true,processes_verified:true}));
+  const h=await getHealth({healthPath:f} as any);
+  assert.notEqual(h.status,'HEALTHY');assert.equal(h.queryFresh,false);assert.equal(h.processesVerified,false);
+ }finally{await fs.rm(dir,{recursive:true});}
+});
+
+test('future health timestamps fail closed',async()=>{
+ const dir=await fs.mkdtemp(path.join(os.tmpdir(),'ssam-future-'));
+ try { const f=path.join(dir,'h.json');await fs.writeFile(f,JSON.stringify({utc:'2999-01-01T00:00:00Z',status:'HEALTHY',query_fresh:true}));
+ const h=await getHealth({healthPath:f} as any);assert.notEqual(h.status,'HEALTHY');assert.equal(h.queryFresh,false);
+ }finally{await fs.rm(dir,{recursive:true});}
+});
+
+test('missing log paths return explicit unavailable responses without raw ENOENT',async()=>{
+ const dir=await fs.mkdtemp(path.join(os.tmpdir(),'ssam-missing-log-'));
+ try {
+  const cfg=path.join(dir,'servers.json');
+  // Registry is resolved once at module load; test via the real MCP child with isolated env instead.
+  const {execFile}=await import('node:child_process');const {promisify}=await import('node:util');
+  await fs.writeFile(cfg,JSON.stringify({servers:[{id:'fixture',name:'fixture',host:'127.0.0.1',gamePort:25600,queryPort:25601,logPath:'/srv/tse-missing/log',healthPath:'/srv/tse-missing/health',runtimeResultPath:'/srv/tse-missing/result'}]}));
+  const result=await promisify(execFile)(process.execPath,['--import','tsx','--input-type=module','-e',`import {getLogs} from './backend.ts';console.log(JSON.stringify(await getLogs('fixture')))`],{env:{...process.env,ALPHA_SERVERS_CONFIG:cfg}});
+  const value=JSON.parse(result.stdout);assert.equal(value.available,false);assert.deepEqual(value.alerts,['LOG_SOURCE_UNAVAILABLE']);assert.deepEqual(value.events,[]);
+ }finally{await fs.rm(dir,{recursive:true});}
+});
+
+test('GameSpy collects out-of-order fragments before returning all players',async()=>{
+ const dgram=await import('node:dgram');const {gameSpyQuery}=await import('../backend.js');
+ const sock=dgram.createSocket('udp4');await new Promise<void>(resolve=>sock.bind(0,'127.0.0.1',resolve));
+ sock.on('message',(_,peer)=>{
+  sock.send(Buffer.from('\\player_1\\B\\final\\\\queryid\\7.2'),peer.port,peer.address);
