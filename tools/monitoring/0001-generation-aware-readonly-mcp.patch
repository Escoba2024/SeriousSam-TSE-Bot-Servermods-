+  <div className="logpanel">{data.events.length?data.events.map((line,i)=><div key={i} className={/SYNCBAD|error|warning/i.test(line)?'logwarn':''}>{line}</div>):<p>Keine entsprechenden Ereignisse gefunden.</p>}</div></>}
+ </>;
+}
+export function StatisticsHistory({available,children}:{available?:boolean;children:React.ReactNode}){
+ return <>{available===false&&<div className="message error">Besucherhistorie nicht verfügbar. Das Live-Ranking wird unabhängig abgefragt.</div>}{children}</>;
+}
