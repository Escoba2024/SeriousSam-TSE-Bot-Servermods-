+import React from 'react';
+export type LogResponse={events:string[];partialHistory:boolean;filter:string;available?:boolean};
+export function LogHistory({data}:{data:LogResponse}){
+ return <><h2>Live-Logs · {data.filter}</h2>{data.available===false?
+  <div className="message error">Logquelle nicht verfügbar. Keine Aussage über Ereignisse oder Syncfehler möglich.</div>:
